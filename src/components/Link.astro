---
import { cn } from "@lib/utils";
import { Icon } from "astro-icon/components";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  group?: boolean;
  extraClass?: string
};

const {
  href,
  external,
  underline = true,
  group = false,
  extraClass,
  ...rest
} = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  class={cn(
    "inline-block decoration-dotted decoration-black/60 text-black/60 dark:decoration-white/60 hover:decoration-black/90 focus-visible:decoration-black/50 dark:hover:decoration-white/60 dark:focus-visible:decoration-white/50 focus-visible:text-black dark:text-white transition-colors duration-300 ease-in-out",
    underline && "underline underline-offset-[3px]",
    group && "group",
      extraClass
  )}
  {...rest}
>
  <div class="flex flex-row items-center">
    <slot />
    {external && <Icon size={16} name="uses/arrow" class="ml-0.5"/>}
  </div>
</a>
