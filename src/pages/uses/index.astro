---

<Layout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
    <Container>
        <div class="space-y-10" data-pagefind-ignore>
            <div class="animate font-bold text-black dark:text-white">
                What I use?
            </div>
            <div class="animate not-prose flex flex-col gap-4">
                A treasure trove of gizmos and gadgets that make me appear brainier than a rocket scientist when I'm
                really just winging it!
            </div>
            <div class="animate">
                <div class="rounded">
                    <div>
                        <ul class="flex" id="tabs">
                            {tabs.map(tab => (
                                    <li class="-mb-px mr-1">
                                        <button
                                                class="text-xl inline-block py-2 px-4 font-semibold"
                                                data-tab={tab.id}
                                        >
                                            {tab.title}
                                        </button>
                                    </li>
                            ))}
                        </ul>
                    </div>
                    <div class="p-4">
                        {tabs.map(tab => (
                                <div id={tab.id} class="tab-content">
                                    {tab.data.map(item => (
                                            <div>
                                                <div class="animate mb-4 flex flex-row items-start contents-start">
                                                    <div class="mr-3 p-1">
                                                        <Icon is:inline title={item.title} size={25}
                                                              name={item.icon}/>
                                                    </div>
                                                    <div>
                                                        <Link href={item.url} external
                                                              extraClass="font-semibold ">{item.title}</Link>
                                                        {item.description &&
                                                                <div class="text-sm mt-0.5">{item.description}</div>}
                                                    </div>
                                                </div>
                                            </div>

                                    ))}
                                </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </Container>
</Layout>

<style>
    .hidden {
        display: none;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const tabs = document.querySelectorAll('[data-tab]');
        const contents = document.querySelectorAll('.tab-content');

        tabs.forEach(tab => {
            tab.addEventListener('click', function (this: Element) {
                const tabId: string = this.getAttribute('data-tab') as string;

                contents.forEach(content => {
                    content.classList.add('hidden');
                });
                let activeContent = document.getElementById(tabId);
                if(activeContent) {
                    activeContent.classList.remove('hidden');
                }

                tabs.forEach(button => {
                    button.classList.remove('dark:text-white', 'border-b', 'border-blue-500');
                });
                this.classList.add('dark:text-white', 'border-b', 'border-blue-500');
                this.classList.remove('text-gray-500');
            });
        });

        // Show the first tab by default
        let firstTab = tabs[0] as HTMLElement;
        firstTab.click();
    });
</script>